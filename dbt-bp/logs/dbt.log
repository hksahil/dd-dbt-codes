/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.dbt_custom.user_orders", "profile_name": "dbt_custom", "target_name": "dev"} */

  
  create view "dev"."main"."user_orders__dbt_tmp" as (
    -- dbt-bp/models/user_orders.sql


-- ========================================================
-- BEST PRACTICES DEMONSTRATED:
-- 1. Tags: tags=['core', 'daily'] (run via: dbt run --select tag:core)
-- 2. Hooks: pre_hook (before model builds) & post_hook (after model builds)
-- 3. Variables: 50
-- 4. Target Awareness: conditional logic based on target.name
-- ========================================================

select
    u.id as user_id,
    u.name as user_name,
    o.order_id,
    o.amount,
    o.status
from users u
join orders o on u.id = o.user_id
where o.amount >= 50

-- In dev environment, limit rows to speed up development
limit 5

  );

